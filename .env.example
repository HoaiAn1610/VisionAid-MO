# Chỉ biến PUBLIC (được bundle vào app) — KHÔNG đặt secret ở đây
# Mặc định: server backend đã deploy (HTTPS). Chạy backend local (docker-compose, cổng 5002):
#   emulator → http://10.0.2.2:5002 ; máy thật → http://<IP-LAN-máy-dev>:5002
EXPO_PUBLIC_API_BASE_URL=https://api.visionaid.net
EXPO_PUBLIC_SIGNALR_URL=https://api.visionaid.net/hubs/location
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_PRIVACY_POLICY_VERSION=1.0
